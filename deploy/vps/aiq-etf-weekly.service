[Unit]
Description=ai-quant ETF weekly summary (always sends, doubles as a heartbeat)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aiq
WorkingDirectory=/opt/ai-quant-research
EnvironmentFile=/etc/ai-quant/telegram.env
ExecStart=/opt/ai-quant-research/.venv/bin/ai-quant etf plan --fetch-sse --skip-stale-quotes --notify always
