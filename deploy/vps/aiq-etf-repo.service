[Unit]
Description=ai-quant reverse repo reminder (Telegram only when Thursday or rate above threshold)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=aiq
WorkingDirectory=/opt/ai-quant-research
EnvironmentFile=/etc/ai-quant/telegram.env
ExecStart=/opt/ai-quant-research/.venv/bin/ai-quant etf repo-check --notify action
